# </recode> — build-time environment
#
# Copy to `.env` and fill in. These values are INLINED by Metro during
# `expo export`, so they must be set BEFORE the build runs. Setting them at
# runtime has no effect on an already-exported bundle.

# Origin of the tRPC/Express server (no trailing slash).
# The client calls `${EXPO_PUBLIC_API_BASE_URL}/api/trpc`.
# Leave unset and the client falls back to deriving the origin from the page
# hostname (8081-* -> 3000-*), which only works in the Expo dev sandbox.
EXPO_PUBLIC_API_BASE_URL=

# OAuth portal + app identity. Required for sign-in; the app runs without it
# but the login button will report that configuration is unavailable.
EXPO_PUBLIC_OAUTH_PORTAL_URL=
EXPO_PUBLIC_OAUTH_SERVER_URL=
EXPO_PUBLIC_APP_ID=

# Server-side only (never exposed to the client bundle):
# DATABASE_URL=mysql://user:pass@host:3306/recoder
# OAUTH_SERVER_URL=https://your-oauth-server.example.com
# EXPO_WEB_PREVIEW_URL=https://your-app-origin.example.com
