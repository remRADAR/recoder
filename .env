# Public runtime config for the Expo client.
#
# EXPO_PUBLIC_* values are inlined into the client bundle at build time, so this
# must be present before `expo export`. Without it the client falls back to
# getApiBaseUrl() in constants/oauth.ts, which can only guess the API host on web
# by rewriting an "8081-" Metro hostname to "3000-" — a sandbox-local convention
# that does not hold for a static export or a device build.
#
# The tRPC server reads PORT (server/_core/index.ts), default 3000, and the dev
# script pins PORT=3000. Point the client at the same origin.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
